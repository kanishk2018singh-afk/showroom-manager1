# Showroom Manager — Android app ke secrets (AI Studio convention)
#
# Ye file sirf PLACEHOLDER rakhti hai — isse build ke liye BuildConfig fields ban jate hain.
# Asli keys ke liye repo root me `.env` banayein (wo git me commit NA karein):
#
#   GEMINI_API_KEY=AIza...your-key...
#
GEMINI_API_KEY=MY_GEMINI_API_KEY
FIREBASE_APPCHECK_DEBUG_TOKEN=
